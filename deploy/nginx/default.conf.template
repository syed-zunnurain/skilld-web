# Restore visitor IPs and HTTPS scheme only for trusted Cloudflare peers.
include /etc/nginx/snippets/cloudflare-real-ip.conf;

server {
    listen 80;
    listen [::]:80;
    server_name ${SITE_DOMAIN};
    server_tokens off;
    client_max_body_size 32k;

    # Docker DNS is re-resolved when the web container is recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $web_upstream web:3000;

    location / {
        proxy_pass http://$web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $skilld_forwarded_proto;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Skilld-Client-IP $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
