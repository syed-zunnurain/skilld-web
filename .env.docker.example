# DNS hostname only: no scheme, path, or trailing slash.
SITE_DOMAIN=register.example.com

# Browser-facing URL: HTTPS at Cloudflare, even though Nginx listens on HTTP.
# Changing this value requires rebuilding the web image (metadata is built in).
SITE_URL=https://register.example.com

# Runtime, server-only URL; include /api. HTTPS is required off localhost.
SKILLD_API_URL=https://api.example.com/api

# Optional local Docker image tag.
IMAGE_TAG=latest

# Nginx origin listener. For a local test, use 127.0.0.1 and port 8080.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
