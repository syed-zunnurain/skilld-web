# Required by the server-side agent API proxy. Use HTTPS outside local development.
SKILLD_API_URL=http://localhost:8000/api

# Used to generate canonical social-card URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public origin for the Node server behind a reverse proxy.
# Docker Compose configures this from SITE_URL in .env.docker.
# SKILLD_WEB_ORIGIN=https://skilld.pk
